    "tsup": "^8.5.1",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "axios": ">=1.0.0",
    "clsx": "^2.1.1",
    "humps": "^2.0.1",
    "tailwind-merge": "^2.3.0",
    "tailwindcss": "^3.4.1",
    "tailwindcss-animate": "^1.0.7"
  },
  "peerDependencies": {
